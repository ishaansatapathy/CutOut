# ============================================================
# CutOut Unified Environment Configuration (Template)
# Copy this file to .env at the root of the project:
# cp .env.example .env
# ============================================================

# Core Secrets
JOB_SECRET=your_64_char_hex_job_secret_here
AUTH_SECRET=your_64_char_hex_auth_secret_here

# Service URLs
AI_URL=http://127.0.0.1:8100
APP_URL=http://localhost:3001

# Google OAuth 2.0 (PKCE)
# Register redirect URI: http://localhost:3001/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Image Generation Provider ("openai", "gemini", or "local")
GEN_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# Payments (Razorpay UPI - leave empty for simulated dev credits)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Rewarded Ads ("test" for simulated ads, "gpt" for Google Publisher Tag)
NEXT_PUBLIC_AD_PROVIDER=test
NEXT_PUBLIC_GPT_REWARDED_UNIT=

# Bot protection for the anonymous free tier (leave blank to disable; recommended before
# going to production, since anonymous use needs no sign-in). dash.cloudflare.com -> Turnstile
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Database (leave blank for local SQLite, or set Postgres URL, e.g. Neon)
DATABASE_URL=
